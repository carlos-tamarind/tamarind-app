# Copy to .env and fill in. Never commit real values.

# Backend (client-safe, publishable)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_DEBUG_LOGS=false

# Server-side only — never expose to the browser, never commit
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Platform access
PLATFORM_OWNER_EMAILS=

# Worker secrets (one per background worker)
EMBEDDING_WORKER_SECRET=
CTI_WORKER_SECRET=
PAGE_CHUNKING_WORKER_SECRET=
PAGE_EMBEDDING_WORKER_SECRET=
PAGE_SEMANTIC_WORKER_SECRET=
CONVERSATION_SUGGESTIONS_WORKER_SECRET=
CANONICAL_TOPICS_WORKER_SECRET=
PURGE_WORKER_SECRET=
